msgid "%(product_count)d ürün · %(vote_count)d oy"
msgstr "%(product_count)d products · %(vote_count)d votes"

msgid "Çok fazla oy isteği gönderdin. Lütfen biraz bekle."
msgstr "You've sent too many vote requests. Please wait a bit."

msgid "Bu anketin süresi doldu."
msgstr "This poll has expired."

msgid "Bu anket oylamaya kapalı."
msgstr "This poll is closed for voting."

msgid "Kendi anketine oy veremezsin."
msgstr "You can't vote on your own poll."

msgid "Bu IP adresinden bu ürüne zaten oy verilmiş."
msgstr "A vote has already been cast for this product from this IP address."

msgid ""
"Görsel yükleme şu anda yapılandırılmamış. Bunun yerine \"Görsel linki\" "
"alanını kullanabilirsin."
msgstr ""
"Image upload isn't configured right now. You can use the \"Image link\" "
"field instead."

msgid "Görsel yüklenemedi, lütfen tekrar dene."
msgstr "The image couldn't be uploaded, please try again."

msgid "Henüz oy yok"
msgstr "No votes yet"

msgid "Anketin yayında! 🎉 Linki paylaşarak daha çok oy toplayabilirsin."
msgstr "Your poll is live! 🎉 Share the link to collect more votes."

msgid "Bu anket oy almış, artık düzenlenemez."
msgstr "This poll has received votes and can no longer be edited."

msgid "Anket güncellendi."
msgstr "Poll updated."

msgid "Yorumun eklendi."
msgstr "Your comment was added."

msgid "Yorumun silindi."
msgstr "Your comment was deleted."

msgid "Geçersiz oy değeri."
msgstr "Invalid vote value."

msgid "Bu anketi zaten şikayet ettin."
msgstr "You've already reported this poll."

msgid "Şikayetin alındı, ekibimiz inceleyecek."
msgstr "Your report has been received, our team will review it."

msgid "Anket silindi."
msgstr "Poll deleted."

msgid "Sayfa bulunamadı"
msgstr "Page not found"

msgid "Bu sayfa terazide yok"
msgstr "This page isn't on the scale"

msgid "Ana sayfaya dön"
msgstr "Back to home"

msgid "Bir şeyler ters gitti"
msgstr "Something went wrong"

msgid ""
"Özür dileriz, beklenmedik bir hata oluştu. Lütfen daha sonra tekrar dene."
msgstr "We're sorry, an unexpected error occurred. Please try again later."

