# Django backend the Next.js server proxies /api/* to (see next.config.ts).
BACKEND_URL=http://127.0.0.1:8000

# Cloudflare Turnstile site key (public by design, not a secret) — must match
# the root project's TURNSTILE_SITE_KEY so the widget on /kayit validates
# against the same Django TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
